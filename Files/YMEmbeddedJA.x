NSString *YMEmbeddedJapanese(NSString *key) {
    if (!key) return nil;

    static NSDictionary<NSString *, NSString *> *table = nil;
    static dispatch_once_t onceToken;
    dispatch_once(&onceToken, ^{
        NSUInteger n = sizeof(kYMJAKeys) / sizeof(kYMJAKeys[0]);
        table = [NSDictionary dictionaryWithObjects:kYMJAValues forKeys:kYMJAKeys count:n];
    });

    return table[key];
}
